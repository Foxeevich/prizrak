# ── Dependencies / build output ─────────────────────────────────────────────
node_modules/
dist/
out/
*.log
# NB: we do NOT ignore a generic "build/" — packages/desktop/build/ holds
# electron-builder resources (icons, afterPack.cjs). Ignore only OUTPUT dirs:
packages/mobile/android/app/build/
packages/mobile/android/build/

# ── Runtime data (user data, keys, SQLite stores) — NEVER commit ─────────────
data/

# ── Generated by sync scripts (regenerated on prestart/predist) ─────────────
packages/desktop/lib/
packages/mobile/src/lib/

# ── Secrets: NEVER commit ───────────────────────────────────────────────────
# Update signing PRIVATE key (public key ships in clients for verification)
update-maintainer.key
# Server config with secrets — use prizrak.config.example.json as a template
prizrak.config.json
# TLS certificates / keys
packages/transport/certs/*.pem
*.pem
*.key
*.p12
# Android signing keystores & local machine config
*.keystore
*.jks
packages/mobile/android/local.properties

# ── Native / mobile build caches ────────────────────────────────────────────
.gradle/
.cxx/
packages/mobile/android/app/build/
packages/mobile/android/.gradle/
packages/mobile/ios/Pods/
packages/mobile/ios/build/
packages/mobile/ios/DerivedData/
*.xcworkspace/xcuserdata/

# ── Packaged artifacts / archives ───────────────────────────────────────────
*.zip
*.tgz
*.tar.gz
*.apk
*.aab
*.dmg
*.AppImage
*.exe
*.blockmap
releases/

# ── OS / editor cruft ───────────────────────────────────────────────────────
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/
_to_delete/
